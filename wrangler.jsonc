{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiempos-equipo",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tiempos-equipo","database_id": "027ad72e-28c8-42f8-ba76-54b4d747f38d"
    }
  ],
  "vars": {
    "ZONA_HORARIA": "Europe/Madrid"
  }
}
